{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/prompt_package",
  "title": "Provider Prompt Package",
  "description": "Replaceable provider-specific compilation output derived from stable shot intent.",
  "type": "object",
  "required": ["version", "id", "shot_plan_id", "continuity_report_id", "compiler_version", "compiled_shots"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "id": { "type": "string" },
    "shot_plan_id": { "type": "string" },
    "continuity_report_id": { "type": "string" },
    "compiler_version": { "type": "string" },
    "compiled_shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shot_id", "provider", "model", "mode", "prompt", "parameters", "reference_bindings"],
        "properties": {
          "shot_id": { "type": "string" },
          "provider": { "type": "string" },
          "model": { "type": "string" },
          "mode": { "type": "string" },
          "prompt": { "type": "string", "minLength": 1 },
          "negative_prompt": { "type": ["string", "null"] },
          "parameters": { "type": "object", "additionalProperties": true },
          "reference_bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["asset_id", "role"],
              "properties": {
                "asset_id": { "type": "string" },
                "role": { "type": "string" },
                "exclude_transfer": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": false
            }
          },
          "compile_notes": { "type": "array", "items": { "type": "string" } },
          "estimated_cost_usd": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
