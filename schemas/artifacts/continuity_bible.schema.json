{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/continuity_bible",
  "title": "Continuity Bible",
  "description": "Global identity, asset, environment, lighting, and geography facts that persist across independently generated shots.",
  "type": "object",
  "required": ["version", "id", "scene_intent_id", "characters", "environment", "geography"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "id": { "type": "string" },
    "scene_intent_id": { "type": "string" },
    "visual_direction": { "type": "string" },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["character_id", "identity_traits", "wardrobe"],
        "properties": {
          "character_id": { "type": "string" },
          "identity_traits": { "type": "array", "items": { "type": "string" } },
          "wardrobe": { "type": "array", "items": { "type": "string" } },
          "approved_reference_ids": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "initial_state"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "initial_state": { "type": "string" },
          "locked_traits": { "type": "array", "items": { "type": "string" } },
          "approved_reference_ids": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "environment": {
      "type": "object",
      "required": ["description", "time_of_day", "lighting_state"],
      "properties": {
        "description": { "type": "string" },
        "time_of_day": { "type": "string" },
        "lighting_state": { "type": "string" },
        "weather_or_atmosphere": { "type": "string" },
        "approved_reference_ids": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "geography": {
      "type": "object",
      "required": ["anchors", "active_axis"],
      "properties": {
        "anchors": { "type": "array", "items": { "type": "string" } },
        "active_axis": { "type": "string" },
        "default_camera_side": { "type": "string" },
        "screen_side_assignments": { "type": "object", "additionalProperties": { "type": "string" } },
        "intentional_axis_crossing_plan": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "global_must_keep": { "type": "array", "items": { "type": "string" } },
    "global_must_avoid": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
